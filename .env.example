# Database connection string
DATABASE_URL="file:./dev.db"

# Session encryption secret
SESSION_SECRET="your-secure-random-32-byte-secret"

# Public application base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP Settings (Leave empty to use automatic Ethereal test inbox + in-app dev mailbox)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="LinguaLearn <noreply@lingualearn.app>"

# Optional Google Gemini AI API key for enhanced real-time translation & chat
GEMINI_API_KEY=""
